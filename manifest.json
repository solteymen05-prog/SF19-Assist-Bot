{
  "manifest_version": 3,
  "name": "SF19 Assist (Chess.com + Lichess)",
  "version": "2.6.0",
  "description": "History-aware Stockfish 19 move hints + ECO opening lookup for Chess.com and Lichess. Manifest V3.",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.chess.com/*",
    "https://chess.com/*",
    "https://lichess.org/*",
    "https://*.lichess.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*",
        "https://lichess.org/*",
        "https://*.lichess.org/*"
      ],
      "js": [
        "chesslib.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "engine/stockfish-19-lite-single.js",
        "engine/stockfish-19-lite-single.wasm",
        "openings.json"
      ],
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*",
        "https://lichess.org/*",
        "https://*.lichess.org/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
